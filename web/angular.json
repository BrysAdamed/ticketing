{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ticketing-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "tk",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "index.css",
                "input": "node_modules/@excalidraw/excalidraw/dist/prod",
                "output": "excalidraw"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@excalidraw/excalidraw/dist/prod/fonts",
                "output": "excalidraw/fonts"
              }
            ],
            "allowedCommonJsDependencies": [
              "react",
              "react-dom",
              "react-dom/client",
              "scheduler",
              "use-sync-external-store",
              "@braintree/sanitize-url",
              "@excalidraw/markdown-to-text",
              "canvas-roundrect-polyfill",
              "es6-promise-pool",
              "fuzzy",
              "lodash.debounce",
              "lodash.throttle",
              "pica",
              "png-chunk-text",
              "png-chunks-encode",
              "png-chunks-extract",
              "cytoscape-cose-bilkent",
              "cytoscape-fcose",
              "dayjs",
              "elkjs",
              "fastdom"
            ],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "ticketing-web:build:production"
            },
            "development": {
              "buildTarget": "ticketing-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "exclude": ["**/*.perf.spec.ts"]
          },
          "configurations": {
            "perf": {
              "include": ["**/*.perf.spec.ts"],
              "exclude": []
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
