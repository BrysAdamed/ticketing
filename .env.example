# Copy to .env and adjust. docker compose reads .env from the repository root.

# PostgreSQL password (db service and the API connection string). Required; replace it.
# `dotnet run` (Development) connects with the password in src/Ticketing.Api/appsettings.Development.json (change-me),
# so keep the two in sync locally or set ConnectionStrings__Db.
DB_PASSWORD=change-me

# First administrator, created on startup only while the user table is empty (spec 6.14). Password: 12+ characters.
TICKETING_BOOTSTRAP_ADMIN_EMAIL=admin@ticketing.local
TICKETING_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-2026!

# Secure flag on session/XSRF cookies. SameAsRequest works over plain HTTP and still marks cookies Secure behind TLS
# (forwarded headers are enabled). Use Always when TLS always terminates in front of the stack.
COOKIE_SECURE_POLICY=SameAsRequest

# Production hides the Scalar UI; use Development to enable it.
ASPNETCORE_ENVIRONMENT=Production

# Development and demos only: fill an empty workspace (no projects yet) with demo users, projects and tickets at startup.
# Never enable it on a real installation. Demo users sign in with TICKETING_DEMO_PASSWORD, or with set-password links
# written to the API log when it is empty. See docs/development/backend.md.
TICKETING_SEED_DEMO=false

# Host ports: web (nginx + SPA) 8080, API for `ng serve` proxying 5080.
# PostgreSQL 5433 is published only by docker-compose.override.yml (development).
WEB_HOST_PORT=8080
API_HOST_PORT=5080
DB_HOST_PORT=5433
