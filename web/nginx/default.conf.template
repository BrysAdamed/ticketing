map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

# TLS terminates in front of nginx (a company reverse proxy); keep the scheme it reports, else our own.
map $http_x_forwarded_proto $forwarded_proto {
  ''      $scheme;
  default $http_x_forwarded_proto;
}

# HSTS only when the browser reached us over HTTPS (an empty value sends no header).
map $forwarded_proto $hsts {
  https   "max-age=31536000";
  default '';
}

# Access logs never record set-password tokens or other query strings carried in a Referer.
map $request_uri $loggable_request_uri {
  ~^/set-password /set-password;
  default         $request_uri;
}

map $http_referer $loggable_referer {
  "~^(?<referer_without_query>[^?]*)[?]" $referer_without_query;
  default                                $http_referer;
}

log_format ticketing '$remote_addr - $remote_user [$time_local] "$request_method $loggable_request_uri $server_protocol" '
                     '$status $body_bytes_sent "$loggable_referer" "$http_user_agent"';

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 11m;
  access_log /var/log/nginx/access.log ticketing;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
  set $api_upstream http://${API_UPSTREAM};

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_proxied any;
  gzip_types text/plain text/css text/csv application/javascript application/json application/problem+json image/svg+xml;

  proxy_http_version 1.1;
  include /etc/nginx/snippets/proxy-headers.conf;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_read_timeout 60s;
  }

  location /mcp {
    proxy_pass $api_upstream;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Upgrade $http_upgrade;
    proxy_buffering off;
    proxy_cache off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /scalar {
    proxy_pass $api_upstream;
  }

  location /health {
    proxy_pass $api_upstream;
    access_log off;
  }

  # A CSP on a script response only governs a worker started from it (documents keep the policy above), so
  # Excalidraw's font-subsetting worker may compile its WebAssembly glue while the page itself stays eval-free (ADR 0014).
  location ~* "-[a-z0-9_-]{8}\.(?:js|css)$" {
    include /etc/nginx/snippets/script-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location /media/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location = /index.html {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
